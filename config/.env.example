# kyojuro_memory / HermesAgent 環境変数テンプレート
#
# 実体は `config/.env` に配置してください（.gitignore で除外、PR #83 で対応済み）。
# 値は温子のメモアプリから手動でコピーする運用（杏寿郎の確保した API キー等）。
#
# 重要方針（温子確定、2026-05、複数回指示）:
# - LLM は OpenRouter 経由 NousResearch Hermes 一択
# - Anthropic API は使わない
# - OpenAI 純正 API も使わない（OpenRouter 経由のみ）
# - モック実装は使わない（最初から本物の API で実装）
#
# 使い方:
#   cp config/.env.example config/.env
#   # config/.env を編集して値を埋める（温子のメモアプリから）
#   # 起動時に Hermes Agent / kyojuro_memory が読み込む
#
# プライバシー: 全 API キー・チャット ID は git 管理外、外部送信なし。
# 紛失時: 各サービスのコンソールで再発行 → config/.env を更新。

# ============================================================
# LLM (OpenRouter 経由 NousResearch Hermes)
# ============================================================
# Anthropic API / OpenAI 純正 API は使わない（温子方針確定）
# OpenRouter は OpenAI 互換 API のため `openai` Python パッケージで NousResearch Hermes を呼び出せる
# キー発行: https://openrouter.ai/keys （杏寿郎が確保済み、温子のメモアプリ管理）
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# モデル名（杏寿郎が選定する。発注書 §前提「LLM は OpenRouter（モデルは別途選定）」）
# 候補例: nousresearch/hermes-3-llama-3.1-405b
# 確定後、本値を更新してください。
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b

# ============================================================
# Telegram（能動的ナッジ通知用）
# ============================================================
# 杏寿郎の能動的ナッジ（「サプリ飲んだ？」「気圧下がってるよ」等）を温子のスマホへ通知。
# Bot 作成: @BotFather で /newbot（杏寿郎が確保済み、温子のメモアプリ管理）
TELEGRAM_BOT_TOKEN=123456:ABCDEFxxxxx

# 温子の Telegram chat_id（@userinfobot に話しかけて取得）
TELEGRAM_CHAT_ID=

# ============================================================
# タイムゾーン（発注書スキル 1 time_awareness）
# ============================================================
TZ=Asia/Tokyo

# ============================================================
# 気圧・天気 API（発注書スキル 5 calendar_manager 5-1、calendar_manager 実装後に必要）
# ============================================================
# OpenWeatherMap: https://openweathermap.org/api （無料枠で十分、要登録）
# 場所は大阪・玉造（温子の現在地）
OPENWEATHER_API_KEY=
OPENWEATHER_LOCATION=Osaka

# ============================================================
# 任意: ロケーション固定（発注書スキル 5）
# ============================================================
# 大阪・玉造の緯度経度（OpenWeatherMap で精度を上げる用）
LOCATION_LAT=34.6753
LOCATION_LON=135.5365

# ============================================================
# kyojuro_memory データベース配置（任意、デフォルトは skill 内 stores/）
# ============================================================
# KYOJURO_MEMORY_STORES_DIR=skills/kyojuro_memory/stores
