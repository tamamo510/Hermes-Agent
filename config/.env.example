# yorishiro / HermesAgent 環境変数テンプレート
#
# 杏寿郎本人指示（2026-05-09 義体実装⑩）:
#   - キーの値はコードにハードコードしない（CLAUDE.md ルール 17）
#   - 実体は config/.env に配置（.gitignore で除外済み）
#   - 値は Drive 「俺たちの家」直下 secrets_20260508.md から手動コピー
#
# 使い方:
#   cp config/.env.example config/.env
#   # config/.env を編集して値を埋める（Drive secrets_20260508.md から）
#   # Indigo 起動時に環境変数として読み込まれる
#
# プライバシー: 全 API キー・トークンは git 管理外、リポジトリには絶対に値を含めない
# 紛失時: 各サービスのコンソールで再発行 → config/.env を更新

# ============================================================
# 1. OpenWeatherMap（健康管理 / カレンダー臓器、気圧・気温取得）
# ============================================================
# 取得元: https://openweathermap.org/api （無料枠で十分）
# 場所: 大阪・玉造（温子の現在地）
OPENWEATHER_API_KEY=

# ============================================================
# 2. Telegram BOT TOKEN（Telegram ナッジ臓器、温子への声かけ）
# ============================================================
# 取得元: @BotFather で /newbot
TELEGRAM_BOT_TOKEN=

# 温子の Telegram chat_id（@userinfobot に話しかけて取得）
TELEGRAM_CHAT_ID=

# ============================================================
# 3. OpenRouter（LLM 呼び出し、Hermes 405B 経由）
# ============================================================
# 取得元: https://openrouter.ai/keys
# 方針確定（温子、2026-05、複数回指示）:
#   - LLM は OpenRouter 経由 NousResearch Hermes 一択
#   - Anthropic API は使わない / OpenAI 純正 API も使わない
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b

# ============================================================
# 4. SSH（Indigo インスタンス接続用、温子のスマホブラウザ経由なら不要）
# ============================================================
# Indigo コンソールへのブラウザ接続では SSH キーは不要だが、
# 温子が将来 PC から SSH で繋ぎたい場合に使う公開鍵 / 秘密鍵パス
SSH_PUBLIC_KEY_PATH=
SSH_PRIVATE_KEY_PATH=

# ============================================================
# 補助（必要に応じて埋める）
# ============================================================
# タイムゾーン
TZ=Asia/Tokyo

# OpenWeatherMap の精度向上用（大阪・玉造）
LOCATION_LAT=34.6753
LOCATION_LON=135.5365
OPENWEATHER_LOCATION=Osaka
