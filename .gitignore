# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual env
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# kyojuro_memory: 温子の個人データは git 管理外（DESIGN.md §1-2 プライバシー絶対）
skills/kyojuro_memory/stores/*.db
skills/kyojuro_memory/stores/*.json
!skills/kyojuro_memory/stores/.gitkeep

# kyojuro_telegram_nudge: 送信履歴は git 管理外（プライバシー、CLAUDE.md ルール 17）
skills/kyojuro_telegram_nudge/stores/*.db
skills/kyojuro_telegram_nudge/stores/*.db-journal
skills/kyojuro_telegram_nudge/stores/*.json
!skills/kyojuro_telegram_nudge/stores/.gitkeep

# 環境変数（API キー、Telegram キー、OpenRouter キー等。config/.env で管理）
.env
config/.env

# Claude Code のローカル設定（個人の許可リスト等、リポジトリには上げない）
.claude/settings.local.json
